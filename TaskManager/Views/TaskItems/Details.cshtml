@model TaskManager.ViewModels.TaskDetailsViewModel
@using TaskManager.Models

@{
    @* ページ名 *@
    ViewData["Title"] = "タスク詳細";
}

@* タスク詳細画面 *@

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-dark shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-info-circle me-2"></i>タスク詳細</span>        @* ページタイトル *@
                    <span class="badge @(Model.Status == TaskStatuses.Completed ? "bg-success" : "bg-warning text-dark")">
                        @Model.Status
                    </span>
                </div>
                <div class="card-body bg-light">
                    <div class="row mb-4">
                        <div class="col-sm-3 fw-bold text-muted">タイトル</div>
                        <div class="col-sm-9 fs-5">@Model.Title</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-sm-6 fw-bold text-muted">カテゴリ</div>
                                <div class="col-sm-6">@Model.Category</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-sm-6 fw-bold text-muted">優先度</div>
                                <div class="col-sm-6">@Model.Priority</div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-sm-6 fw-bold text-muted">期限</div>
                                <div class="col-sm-6 text-danger fw-bold">@Model.DueDate.ToString("yyyy/MM/dd")</div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <label class="fw-bold text-muted mb-2">詳細説明</label>
                        <div class="p-3 bg-white border rounded" style="min-height: 150px; white-space: pre-wrap;">@Model.Detail</div>
                    </div>

                    <div class="d-flex gap-2 border-top pt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark px-4">
                            <i class="bi bi-pencil-square me-1"></i> 編集する       @* 編集画面へ行くボタン *@
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            一覧に戻る       @* 一覧に行くボタン *@
                        </a>
                    </div>
                </div>
                <div class="card-footer text-muted small d-flex justify-content-between">
                    <span>作成: @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>      @* 作成日表示 *@
                    <span>最終更新: @Model.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</span>        @* 最終更新日表示 *@
                </div>
            </div>
        </div>
    </div>
</div>