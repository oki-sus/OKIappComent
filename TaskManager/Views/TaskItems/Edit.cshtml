@model TaskManager.ViewModels.TaskEditViewModel
@using TaskManager.Models

@{
    ViewData["Title"] = "タスク編集";
}

@* タスク編集画面 *@

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-dark shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-pencil-square me-2"></i>タスク内容の編集        @* ページタイトル *@
                </div>
                <div class="card-body bg-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* ID、作成者、作成日を隠しフィールドで保持する *@
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="@(new TaskItem().Title)" class="form-label fw-bold"></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="@(new TaskItem().Category)" class="form-label fw-bold"></label>
                                <input asp-for="Category" class="form-control" />
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="@(new TaskItem().DueDate)" class="form-label fw-bold"></label>
                                <input asp-for="DueDate" class="form-control" type="date" />
                                <span asp-validation-for="DueDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="@(new TaskItem().Status)" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="@TaskStatuses.NotStarted">@TaskStatuses.NotStarted</option>
                                    <option value="@TaskStatuses.InProgress">@TaskStatuses.InProgress</option>
                                    <option value="@TaskStatuses.Completed">@TaskStatuses.Completed</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="@(new TaskItem().Priority)" class="form-label fw-bold"></label>
                                <select asp-for="Priority" class="form-select">
                                    <option value="@TaskPriority.Low">@TaskPriority.Low</option>
                                    <option value="@TaskPriority.Medium">@TaskPriority.Medium</option>
                                    <option value="@TaskPriority.High">@TaskPriority.High</option>
                                </select>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="@(new TaskItem().Detail)" class="form-label fw-bold"></label>
                                <textarea asp-for="Detail" class="form-control" rows="4"></textarea>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-dark fw-bold px-5">
                                <i class="bi bi-save me-1"></i>更新を保存        @* 保存ボタン *@
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                キャンセル       @* キャンセルボタン *@
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-muted small text-end">
                    作成日時: @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")     @* 作成日を表示 *@
                </div>
            </div>
        </div>
    </div>
</div>

@* 入力チェックライブラリを読み込む *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}