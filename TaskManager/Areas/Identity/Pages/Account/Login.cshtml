@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-dark shadow-sm">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">TASK MANAGER / ログイン</h4>
                </div>
                <div class="card-body bg-light p-4">
                    <form id="account" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label small fw-bold">メールアドレス</label>
                            <input asp-for="Input.Email" class="form-control border-secondary" autocomplete="username" aria-required="true" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label small fw-bold">パスワード</label>
                            <input asp-for="Input.Password" type="password" class="form-control border-secondary" autocomplete="current-password" aria-required="true" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3 small">
                            <input class="form-check-input border-secondary" asp-for="Input.RememberMe" />
                            <label class="form-check-label fw-bold" asp-for="Input.RememberMe">
                                ログイン状態を保持する
                            </label>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 fw-bold">ログイン実行</button>

                        <div class="mt-3 text-center border-top pt-3">
                            <p class="small">
                                <a href="/Identity/Account/Register" class="text-decoration-none text-secondary">新規ユーザー登録はこちら</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>